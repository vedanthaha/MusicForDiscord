# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here

# The numeric guild ID used for instant slash-command registration during
# development. Leave blank (or remove) to register commands globally.
DEV_GUILD_ID=

# ── Lavalink ─────────────────────────────────────────────────────────────────
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
# Set to "true" if Lavalink is behind HTTPS/WSS
LAVALINK_SECURE=false

# ── Arc Music API ─────────────────────────────────────────────────────────────
# Leave ARC_API_KEY blank to disable Arc; the bot falls back to Lavalink search.
ARC_API_KEY=your_arc_api_key_here
ARC_BASE_URL=https://api.arcmusic.fun

# Seconds to wait for an Arc job before giving up (default 60)
ARC_JOB_TIMEOUT=60

# Maximum concurrent Arc jobs per instance (simple in-process semaphore)
ARC_MAX_CONCURRENCY=5

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Used as the persistent cache for Arc-resolved stream URLs.
# Leave blank to use an in-process LRU cache instead.
REDIS_URL=redis://localhost:6379/0

# How long (seconds) to keep a cached Arc URL before re-downloading.
# Arc CDN URLs are usually stable, 24 h is a safe default.
ARC_CACHE_TTL=86400

# ── Bot behaviour ────────────────────────────────────────────────────────────
# Seconds of alone-in-channel inactivity before auto-disconnect
ALONE_TIMEOUT=180
# Default volume (1–100)
DEFAULT_VOLUME=80
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
